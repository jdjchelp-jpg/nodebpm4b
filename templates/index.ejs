        // --- Utility Functions ---

        function formatTime(seconds) {
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = Math.floor(seconds % 60);
            const ms = Math.floor((seconds % 1) * 1000);

            let res = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
            if (ms > 0) {
                res += `.${ms.toString().padStart(3, '0')}`;
            }
            return res;
        }

        function log(msg, type = 'info') {
            const line = document.createElement('div');
            line.className = `log-line ${type}`;
            const time = new Date().toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
            line.innerHTML = `<span class="log-time">[${time}]</span> ${msg}`;
            elements.processLog.prepend(line);

            // Limit log lines
            if (elements.processLog.children.length > 50) {
                elements.processLog.removeChild(elements.processLog.lastChild);
            }
        }

        function showToast(msg, type = 'info') {
            log(msg, type);
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.textContent = msg;
            elements.toastContainer.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        function startPipeline(jobId) {
            state.isProcessing = true;
            jobStartTime = Date.now();
            if (elements.timeRemaining) elements.timeRemaining.classList.remove('hidden');
            elements.progressBar.style.width = '2%';
            elements.progressPercent.innerText = '0%';
            elements.statusText.textContent = 'Initializing...';

            if (jobId) {
                setupSSE(jobId);
            }
        }

        function setupSSE(jobId) {
            // Set active job ID for tracking
            state.activeJobId = jobId;
            const eventSource = new EventSource(`/api/progress/${jobId}`);

            eventSource.onmessage = (event) => {
                const data = JSON.parse(event.data);
                if (data.percent !== undefined && data.percent !== null) {
                    updateProgress(data.percent, data.message);
                } else if (data.message) {
                    log(data.message, 'info');
                    elements.statusText.textContent = data.message;
                }

                if (data.percent === 100 || data.downloadUrl) {
                    eventSource.close();
                    if (data.downloadUrl) {
                        // Extract filename from URL or message if missing
                        let filename = data.filename;
                        if (!filename) {
                            filename = data.downloadUrl.split('/').pop();
                        }
                        
                        // Detect type from JOB ID
                        let type = 'conversion';
                        if (jobId.startsWith('merge')) type = 'merge';
                        if (jobId.startsWith('doc')) type = 'tts';
                        if (jobId.startsWith('clean')) type = 'cleaning';
                        if (jobId.startsWith('folderm4b')) type = 'folderToM4b';
                        if (jobId.startsWith('convert')) type = 'convert';

                        saveToHistory(type, filename, data.downloadUrl);
                        finishPipeline(data.message || 'Complete', data.downloadUrl);
                    } else {
                        // Handle completion without download URL
                        finishPipeline(data.message || 'Complete');
                    }

                }
            };

            eventSource.onerror = () => {
                eventSource.close();
                // Reset processing state on SSE error to prevent stuck state
                if (state.isProcessing && state.activeJobId === jobId) {
                    state.isProcessing = false;
                    state.activeJobId = null;
                    log('Connection lost, processing state reset', 'warning');
                }
            };
        }

        function updateProgress(percent, status) {
            elements.progressBar.style.width = `${percent}%`;
            elements.progressPercent.textContent = `${Math.round(percent)}%`;
            // Also update converter inline progress if visible
            if (elements.converterProgress && !elements.converterProgress.classList.contains('hidden')) {
                elements.converterProgressBar.style.width = `${percent}%`;
                elements.converterPercent.textContent = `${Math.round(percent)}%`;
                if (status) {
                    elements.converterStatusText.textContent = status;
                }
            }
            if (status) {
                elements.statusText.textContent = status;
                log(status, 'info');
            }

            // Estimate time remaining
            if (percent > 5 && jobStartTime) {
                const elapsed = (Date.now() - jobStartTime) / 1000;
                const totalEstimated = elapsed / (percent / 100);
                const remaining = Math.max(0, totalEstimated - elapsed);

                const mm = Math.floor(remaining / 60);
                const ss = Math.floor(remaining % 60);
                if (elements.timeRemaining) {
                    elements.timeRemaining.textContent = `Est: ${mm}:${ss.toString().padStart(2, '0')}`;
                }
            }
        }

        function downloadBlob(blob, filename) {
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
        }

        function finishPipeline(msg, customUrl = null) {
            // Definitively reset processing state and clear active job
            state.isProcessing = false;
            state.activeJobId = null;
            updateProgress(100, msg || 'Pipeline Complete');
            showToast(msg || 'Success', 'success');
            if (elements.timeRemaining) elements.timeRemaining.classList.add('hidden');
            const stopBtn = document.getElementById('stopGenerationBtn');
            if (stopBtn) stopBtn.classList.add('hidden');

            if (customUrl) {
                const a = document.createElement('a');
                a.href = customUrl;
                a.download = '';
                document.body.appendChild(a);
                a.click();
                a.remove();
            }
        }

        function failPipeline(msg) {
            state.isProcessing = false;
            elements.progressBar.style.width = '0%';
            elements.progressPercent.textContent = 'Error';
            elements.statusText.textContent = 'Pipeline failed';
            if (elements.timeRemaining) elements.timeRemaining.classList.add('hidden');
            const stopBtn = document.getElementById('stopGenerationBtn');
            if (stopBtn) stopBtn.classList.add('hidden');
            showToast(msg, 'error');
        }

        // --- Pipeline Execution ---

        async function handleMp3Conversion() {
            const fileInput = document.getElementById('sourceFile');
            if (!fileInput.files.length) return showToast('Select source file', 'error');

            const jobId = 'job_' + Date.now();
            startPipeline(jobId);

            const formData = new FormData();
            formData.append('source_file', fileInput.files[0]);
            formData.append('output_name', document.getElementById('outputName').value);
            formData.append('audio_quality', document.getElementById('audioQuality').value);
            formData.append('jobId', jobId);

            // Add metadata
            const metadata = {
                title: elements.metaTitle.value,
                author: elements.metaAuthor.value,
                genre: elements.metaGenre.value,
                description: elements.metaDescription.value
            };
            formData.append('metadata', JSON.stringify(metadata));

            if (state.coverBase64) {
                formData.append('cover_base64', state.coverBase64);
            }

            if (state.chapters.length > 0) {
                // Ensure field names match backend expectations (start_time)
                const mappedChapters = state.chapters.map(ch => ({
                    title: ch.title,
                    start_time: ch.startTime,
                    end_time: ch.endTime
                }));
                formData.append('chapters', JSON.stringify(mappedChapters));
            }

            try {
                const res = await fetch('/api/convert', { method: 'POST', body: formData });
                if (!res.ok) {
                    const errData = await res.json().catch(() => ({}));
                    throw new Error(errData.error || `Server error ${res.status}`);
                }
                // SSE handles the completion
            } catch (e) {
                failPipeline(e.message);
            }
        }

