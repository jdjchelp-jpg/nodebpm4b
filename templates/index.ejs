            // Bulk Rename logic
            document.getElementById('btn-apply-rename')?.addEventListener('click', () => {
                const pattern = document.getElementById('bulkRenamePattern').value.trim();
                if (!pattern) return showToast('Please enter a pattern', 'warning');
                
                batchFilesArray.forEach((file, index) => {
                    file.name = pattern
                        .replace(/{n}/g, (index + 1).toString().padStart(2, '0'))
                        .replace(/{title}/g, file.name.split('.')[0]);
                    if (!file.name.endsWith('.mp3')) file.name += '.mp3';
                });
                renderBatchList();
                showToast('Pattern applied to all files', 'success');
            });

            // Auto-Split logic (Mock-up for frontend logic)
            document.getElementById('btn-auto-split')?.addEventListener('click', () => {
                const mins = parseInt(document.getElementById('splitDuration').value);
                if (!mins || mins < 5) return showToast('Enter valid duration (min 5)', 'warning');
                showToast('Auto-split logic initiated (server-side support required for full feature)', 'info');
            });

            elements.btnStartMerge.addEventListener('click', handleStartMerge);
        }

        window.renderBatchList = () => {
            elements.batchFileList.innerHTML = batchFilesArray.map((file, index) => `
                <div class="manifest-item" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div class="reorder-handle" onclick="moveBatchItem(${index}, -1)">▲</div>
                    <div class="reorder-handle" onclick="moveBatchItem(${index}, 1)">▼</div>
                    <div style="flex: 1;">
                        <input type="text" class="form-input" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; background: transparent; border-color: transparent;" 
                               value="${file.name}" onchange="updateBatchFileName(${index}, this.value)">
                    </div>
                    <div style="font-size: 0.7rem; color: var(--text-muted);">${(file.size / (1024 * 1024)).toFixed(1)} MB</div>
                    <button class="btn btn-sm" style="color: var(--error); padding: 0.25rem; width: auto;" onclick="removeBatchFile(${index})">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </div>
            `).join('');
            
            elements.btnStartMerge.disabled = batchFilesArray.length < 2;
        };

        window.moveBatchItem = (index, direction) => {
            const newIndex = index + direction;
            if (newIndex < 0 || newIndex >= batchFilesArray.length) return;
            const temp = batchFilesArray[index];
            batchFilesArray[index] = batchFilesArray[newIndex];
            batchFilesArray[newIndex] = temp;
            renderBatchList();
        };

        window.updateBatchFileName = (index, newName) => {
            batchFilesArray[index].name = newName;
            showToast('Chapter renamed', 'info');
        };

        window.removeBatchFile = (index) => {
            batchFilesArray.splice(index, 1);
            renderBatchList();
        };

        function initConverterHandlers() {
            if (!elements.converterDropZone || !elements.converterFile || !elements.btnConvertAudio) return;

            elements.converterDropZone.addEventListener('click', () => elements.converterFile.click());

            elements.converterFile.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) handleConverterFile(file);
            });

            elements.converterDropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                elements.converterDropZone.classList.add('drag-over');
            });

            elements.converterDropZone.addEventListener('dragleave', () => {
                elements.converterDropZone.classList.remove('drag-over');
            });

            elements.converterDropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                elements.converterDropZone.classList.remove('drag-over');
                const file = e.dataTransfer.files[0];
                if (file) handleConverterFile(file);
            });

            if (elements.clearConverterFile) {
                elements.clearConverterFile.addEventListener('click', () => {
                    state.converterFile = null;
                    elements.converterFile.value = '';
                    elements.converterFileInfo.classList.add('hidden');
                    elements.sourceFormat.value = '';
                    elements.targetFormat.value = '';
                    elements.btnConvertAudio.disabled = true;
                    showToast('File cleared', 'info');
                });
            }

            elements.targetFormat.addEventListener('change', () => {
                elements.btnConvertAudio.disabled = !state.converterFile || !elements.targetFormat.value;
            });

            elements.btnConvertAudio.addEventListener('click', handleConvertAudio);
        }

        function handleConverterFile(file) {
            const validExtensions = ['.mp3', '.wav', '.flac', '.aac', '.ogg', '.m4a', '.m4b', '.alac', '.mp4', '.mkv', '.avi', '.mov', '.webm', '.m4v', '.3gp', '.wma', '.opus', '.aiff'];
            const ext = '.' + file.name.split('.').pop().toLowerCase();

            if (!validExtensions.includes(ext)) {
                showToast('Please upload a valid media file (audio or video)', 'error');
                return;
            }

            state.converterFile = file;
            elements.converterFileName.textContent = file.name;
            elements.converterFileInfo.classList.remove('hidden');

            // Auto-detect source format
            const formatMap = {
                '.mp3': 'MP3',
                '.wav': 'WAV',
                '.flac': 'FLAC',
                '.aac': 'AAC',
                '.ogg': 'OGG',
                '.m4a': 'AAC (M4A)',
                '.alac': 'ALAC'
            };
            var videoFormatMap = {
                '.mp4': 'MP4 Video',
                '.mkv': 'MKV Video',
                '.avi': 'AVI Video',
                '.mov': 'MOV Video',
                '.webm': 'WEBM Video',
                '.m4v': 'M4V Video',
                '.3gp': '3GP Video',
                '.wma': 'WMA Audio',
                '.opus': 'OPUS Audio',
                '.aiff': 'AIFF Audio',
                '.m4b': 'M4B Audio'
            };
            elements.sourceFormat.value = formatMap[ext] || videoFormatMap[ext] || ext.toUpperCase();

            elements.btnConvertAudio.disabled = !elements.targetFormat.value;
            showToast('File loaded: ' + file.name, 'success');
        }

        async function handleConvertAudio() {
            if (!state.converterFile || !elements.targetFormat.value) {
                showToast('Please select a file and target format', 'warning');
                return;
            }

            const targetFormat = elements.targetFormat.value;
            const quality = elements.converterQuality.value;

            // Validate lossless option
            if (quality === 'lossless' && !['flac', 'alac'].includes(targetFormat)) {
                showToast('Lossless quality only available for FLAC and ALAC formats', 'warning');
                return;
            }

            state.isProcessing = true;
            elements.btnConvertAudio.disabled = true;
            elements.btnConvertAudio.innerHTML = '<svg class="animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Converting...';

            // Show inline progress bar
            elements.converterProgress.classList.remove('hidden');
            elements.converterProgressBar.style.width = '0%';
            elements.converterPercent.textContent = '0%';
            elements.converterStatusText.textContent = 'Starting conversion...';

            const formData = new FormData();
            formData.append('source_file', state.converterFile);
            formData.append('target_format', targetFormat);
            formData.append('audioQuality', quality);

            const jobId = 'convert-' + Date.now();
            setupSSE(jobId);
            formData.append('jobId', jobId);

            try {
                const res = await fetch('/api/convert', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();

                if (data.error) throw new Error(data.error);

                showToast('Conversion completed!', 'success');
                elements.converterStatusText.textContent = 'Conversion complete!';

                // Trigger download & Save to history
                if (data.downloadUrl) {
                    saveToHistory('conversion', data.filename || `converted.${targetFormat}`, data.downloadUrl);
                    const a = document.createElement('a');
                    a.href = data.downloadUrl;
                    a.download = data.filename || `converted.${targetFormat}`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }
            } catch (e) {
                showToast('Conversion failed: ' + e.message, 'error');
                elements.converterStatusText.textContent = 'Conversion failed: ' + e.message;
                elements.converterProgressBar.style.background = 'var(--danger, #ef4444)';
            } finally {
                state.isProcessing = false;
                elements.btnConvertAudio.disabled = false;
                elements.btnConvertAudio.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4" /></svg> Convert Audio';
            }
        }
        function initFolderToM4bHandlers() {
            if (!elements.folderToM4bPath || !elements.btnFolderToM4b) return;

            elements.btnFolderToM4b.addEventListener('click', handleFolderToM4b);

