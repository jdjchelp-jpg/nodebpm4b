        let batchFilesArray = [];

        function initBatchHandlers() {
            if (!elements.batchDropZone || !elements.batchFiles || !elements.btnStartMerge) return;

            elements.batchDropZone.addEventListener('click', () => elements.batchFiles.click());
            elements.batchFiles.addEventListener('change', (e) => addBatchFiles(Array.from(e.target.files)));

            elements.batchDropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                elements.batchDropZone.classList.add('drag-over');
            });

            elements.batchDropZone.addEventListener('dragleave', () => {
                elements.batchDropZone.classList.remove('drag-over');
            });

            elements.batchDropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                elements.batchDropZone.classList.remove('drag-over');
                addBatchFiles(Array.from(e.dataTransfer.files));
            });

            const btnScan = document.getElementById('btn-scan-folder');
            if (btnScan) {
                btnScan.addEventListener('click', async () => {
                    const folderPath = document.getElementById('localFolderPath').value.trim();
                    if (!folderPath) return showToast('Please enter a folder path', 'error');
                    
                    log(`Scanning local folder: ${folderPath}`, 'info');
                    try {
                        const res = await fetch('/api/scan-folder', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ folderPath })
                        });
                        const data = await res.json();
                        if (data.error) throw new Error(data.error);
                        
                        if (data.files.length === 0) {
                            showToast('No MP3 files found in this folder', 'warning');
                            return;
                        }
                        
                        state.isLocalMode = true;
                        batchFilesArray = data.files.map(f => ({
                            name: f.name,
                            path: f.path,
                            size: f.size,
                            isLocal: true
                        }));
                        renderBatchList();
                        elements.btnStartMerge.disabled = batchFilesArray.length < 2;
