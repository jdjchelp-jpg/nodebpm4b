        async function handleFolderToM4b() {
            var folderPath = elements.folderToM4bPath.value.trim();
            if (!folderPath) {
                showToast('Please enter a folder path', 'error');
                return;
            }

            state.isProcessing = true;
            elements.btnFolderToM4b.disabled = true;
            elements.btnFolderToM4b.innerHTML = '<svg class="animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Converting...';

            // Show inline progress bar
            elements.folderToM4bProgress.classList.remove('hidden');
            elements.folderToM4bProgressBar.style.width = '0%';
            elements.folderToM4bPercent.textContent = '0%';
            elements.folderToM4bStatusText.textContent = 'Starting folder conversion...';

            var metadata = {};
            var title = elements.folderToM4bTitle.value.trim();
            var author = elements.folderToM4bAuthor.value.trim();
            if (title) metadata.title = title;
            if (author) metadata.author = author;

            var jobId = 'folderm4b-' + Date.now();

            // Custom SSE handler with inline progress updates
            state.activeJobId = jobId;
            var eventSource = new EventSource('/api/progress/' + jobId);
            eventSource.onmessage = function(event) {
                var data = JSON.parse(event.data);
                if (data.percent !== undefined && data.percent !== null) {
                    elements.folderToM4bProgressBar.style.width = data.percent + '%';
                    elements.folderToM4bPercent.textContent = Math.round(data.percent) + '%';
                    // Also update global pipeline progress bar
                    elements.progressBar.style.width = data.percent + '%';
                    elements.progressPercent.textContent = Math.round(data.percent) + '%';
                    if (data.message) {
                        elements.folderToM4bStatusText.textContent = data.message;
                        elements.statusText.textContent = data.message;
                        log(data.message, 'info');
                    }
                }

                if (data.percent === 100 || data.downloadUrl) {
                    eventSource.close();
                    state.isProcessing = false;
                    state.activeJobId = null;
                    elements.btnFolderToM4b.disabled = false;
                    elements.btnFolderToM4b.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><polyline points="12 11 12 17"/><line x1="9" y1="14" x2="15" y2="14"/></svg> Convert Folder to M4B';

                    if (data.downloadUrl) {
                        var filename = data.filename || data.downloadUrl.split('/').pop();
                        saveToHistory('folderToM4b', filename, data.downloadUrl);
                        showToast('Folder conversion complete: ' + filename, 'success');
                        elements.folderToM4bStatusText.textContent = 'Complete: ' + filename;
                        var a = document.createElement('a');
                        a.href = data.downloadUrl;
                        a.download = filename;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                    } else {
                        showToast('Folder conversion completed!', 'success');
                        elements.folderToM4bStatusText.textContent = 'Conversion complete!';
                    }
                }
            };

            eventSource.onerror = function() {
                eventSource.close();
                if (state.isProcessing && state.activeJobId === jobId) {
                    state.isProcessing = false;
                    state.activeJobId = null;
                    elements.btnFolderToM4b.disabled = false;
                    elements.btnFolderToM4b.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><polyline points="12 11 12 17"/><line x1="9" y1="14" x2="15" y2="14"/></svg> Convert Folder to M4B';
                    elements.folderToM4bStatusText.textContent = 'Connection lost';
                    elements.folderToM4bProgressBar.style.background = 'var(--danger, #ef4444)';
                    log('Folder-to-M4B SSE connection lost', 'warning');
                }
            };

            try {
                var res = await fetch('/api/folder-to-m4b', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        folderPath: folderPath,
                        metadata: Object.keys(metadata).length > 0 ? JSON.stringify(metadata) : null,
                        audioQuality: elements.folderToM4bQuality.value,
                        jobId: jobId
                    })
                });

                var data = await res.json();
                if (data.error) throw new Error(data.error);

                log('Folder-to-M4B started: ' + folderPath, 'info');
            } catch (e) {
                eventSource.close();
                showToast('Failed: ' + e.message, 'error');
                log('Folder-to-M4B error: ' + e.message, 'error');
                elements.folderToM4bStatusText.textContent = 'Error: ' + e.message;
                elements.folderToM4bProgressBar.style.background = 'var(--danger, #ef4444)';
                state.isProcessing = false;
                elements.btnFolderToM4b.disabled = false;
                elements.btnFolderToM4b.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><polyline points="12 11 12 17"/><line x1="9" y1="14" x2="15" y2="14"/></svg> Convert Folder to M4B';
            }
        }


        function addBatchFiles(files) {
            const mp3s = files.filter(f => f.name.toLowerCase().endsWith('.mp3'));
            if (mp3s.length === 0) return showToast('Only MP3 files are supported for merging', 'warning');

            batchFilesArray = [...batchFilesArray, ...mp3s];
            renderBatchList();
            elements.btnStartMerge.disabled = batchFilesArray.length < 2;
        }

        function renderBatchList() {
            elements.batchFileList.innerHTML = batchFilesArray.map((file, i) => `
                <div class="manifest-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: rgba(255,255,255,0.03); margin-bottom: 0.5rem; border-radius: 6px;">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <span style="color: var(--text-muted); font-size: 0.8rem; font-family: monospace;">#${i + 1}</span>
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-weight: 500;">${file.name}</span>
                            ${file.isLocal ? `<span style="font-size: 0.65rem; color: var(--primary);">Local: ${file.path}</span>` : ''}
                        </div>
                    </div>
                    <button class="btn-icon" onclick="removeBatchFile(${i})" style="color: var(--error);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </div>
            `).join('');
        }

        window.removeBatchFile = (index) => {
            batchFilesArray.splice(index, 1);
            renderBatchList();
            elements.btnStartMerge.disabled = batchFilesArray.length < 2;
        };

        function removeChapter(index) {
            state.chapters.splice(index, 1);
            renderManifest();
        }

        async function previewChapter(id) {
            const index = state.chapters.findIndex(c => c.id == id);
            if (index === -1) return;
            const chapter = state.chapters[index];
            const btn = document.getElementById(`btn-preview-${id}`);
            const originalHTML = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = '<svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';

            try {
                const res = await fetch('/api/preview-chapter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        text: chapter.content || chapter.title, // content exists for doc-based chapters
                        voice: document.getElementById('ttsVoice').value,
                        speed: document.getElementById('ttsSpeed').value,
                        multiVoice: document.getElementById('enableMultiVoice')?.checked || false,
                        dialogueVoice: document.getElementById('dialogueVoice')?.value || null
                    })
                });

                if (!res.ok) throw new Error(await res.text());

                const blob = await res.blob();
                const url = URL.createObjectURL(blob);
                const audio = new Audio(url);
                audio.play();

                showToast(`Playing preview for Chapter ${index + 1}...`, 'info');
            } catch (e) {
                showToast(`Preview failed: ${e.message}`, 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHTML;
            }
        }

        async function handleStartMerge() {
            if (batchFilesArray.length < 2) return;

            state.isProcessing = true;
            elements.btnStartMerge.disabled = true;
            log('Starting batch merge of ' + batchFilesArray.length + ' files...', 'info');

            const jobId = 'merge-' + Date.now();
            setupSSE(jobId);

            const metadata = {
                title: elements.metaTitle.value || 'Merged Audiobook',
                author: elements.metaAuthor.value || 'Various Authors',
                genre: elements.metaGenre.value || 'Audiobook',
                description: elements.metaDescription.value || 'Created with BPM4B Batch Merge'
            };

            const normalize = document.getElementById('normalizeChapters')?.checked || false;

            try {
                let res;
                if (state.isLocalMode) {
                    res = await fetch('/api/batch-merge-local', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            filePaths: batchFilesArray.map(f => f.path),
                            metadata,
                            normalize,
                            cover_base64: state.coverBase64,
                            jobId
                        })
                    });
                } else {
                    const formData = new FormData();
                    batchFilesArray.forEach(file => formData.append('audio_files', file));
                    formData.append('jobId', jobId);
                    formData.append('metadata', JSON.stringify(metadata));
                    formData.append('normalize', normalize);
                    if (state.coverBase64) formData.append('cover_base64', state.coverBase64);

                    res = await fetch('/api/batch-merge', { method: 'POST', body: formData });
                }

                if (!res.ok) throw new Error(await res.text());

                const data = await res.json();
                if (data.success) {
                    showToast('Batch merge complete!', 'success');
                    log('Batch merge completed! File: ' + data.filename, 'success');
                    saveToHistory('merge', data.filename, data.downloadUrl);
                    batchFilesArray = [];
                    renderBatchList();
                } else {
                    throw new Error(data.error || 'Batch merge failed');
                }
            } catch (e) {
                log('Merge failed: ' + e.message, 'error');
                showToast('Merge failed', 'error');
            } finally {
                state.isProcessing = false;
                elements.btnStartMerge.disabled = false;
            }
        }

        // --- Voice Cloning, AI & Utility Tools ---

        // Persist OpenRouter Key & Model
        const orKeyInput = document.getElementById('openRouterKey');
        const aiModelInput = document.getElementById('aiModel');

        orKeyInput.addEventListener('input', (e) => {
            localStorage.setItem('openrouter_key', e.target.value);
        });
        aiModelInput.addEventListener('input', (e) => {
            localStorage.setItem('openrouter_model', e.target.value);
        });

        if (localStorage.getItem('openrouter_key')) {
            orKeyInput.value = localStorage.getItem('openrouter_key');
        }
        if (localStorage.getItem('openrouter_model')) {
            aiModelInput.value = localStorage.getItem('openrouter_model');
        }

        // Fetch Models
        document.getElementById('refreshModels').addEventListener('click', async () => {
            const apiKey = orKeyInput.value;
            if (!apiKey) return showToast('Enter API Key first', 'error');
            
            showToast('Fetching models...', 'info');
            try {
                const res = await fetch('/api/ai/models', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apiKey })
                });
                const data = await res.json();
                if (data.models && data.models.length > 0) {
                    const datalist = document.getElementById('modelList');
                    datalist.innerHTML = data.models.map(m => `<option value="${m.id}">${m.name} (${m.id})</option>`).join('');
                    showToast(`Fetched ${data.models.length} models`, 'success');
                }
            } catch (e) {
                showToast('Failed to fetch models', 'error');
            }
        });

        // Voice Cloning Mode Toggle
        const cloneMode = document.getElementById('cloneMode');
        const cloneSourceGroup = document.getElementById('cloneSourceGroup');
        const cloneTextGroup = document.getElementById('cloneTextGroup');
        
        cloneMode.addEventListener('change', () => {
            if (cloneMode.value === 'tts') {
                cloneSourceGroup.style.display = 'none';
                cloneTextGroup.style.display = 'block';
            } else {
                cloneSourceGroup.style.display = 'block';
                cloneTextGroup.style.display = 'none';
            }
        });

        // Start Voice Cloning
        document.getElementById('startCloneBtn').addEventListener('click', async () => {
            const refFile = document.getElementById('cloneRefFile').files[0];
            const sourceFile = document.getElementById('cloneSourceFile').files[0];
            const text = document.getElementById('cloneText').value;
            const mode = cloneMode.value;
            const lang = document.getElementById('cloneLang').value;

            if (!refFile) return showToast('Please select a reference voice file', 'error');
            if (mode === 'convert' && !sourceFile) return showToast('Please select a source audio file', 'error');
            if (mode === 'tts' && !text) return showToast('Please enter text to synthesize', 'error');

            const jobId = uuidv4();
            setupSSE(jobId);
            state.isProcessing = true;
            log(`Starting voice cloning (${mode} mode)...`, 'info');

            const formData = new FormData();
            formData.append('refAudio', refFile);
            if (mode === 'convert') formData.append('sourceAudio', sourceFile);
            formData.append('text', text);
            formData.append('mode', mode);
            formData.append('lang', lang);
            formData.append('jobId', jobId);

            try {
                const res = await fetch('/api/clone-voice', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.error) throw new Error(data.error);
            } catch (e) {
                log('Cloning failed: ' + e.message, 'error');
                state.isProcessing = false;
            }
        });

        // Audio Cleanup
        document.getElementById('startCleanBtn').addEventListener('click', async () => {
            const file = document.getElementById('cleanFile').files[0];
            const profile = document.getElementById('cleanProfile').value;
            if (!file) return showToast('Please select an audio file', 'error');

            state.isProcessing = true;
            log(`Cleaning audio using ${profile} profile...`, 'info');
            
            const formData = new FormData();
            formData.append('file', file);
            formData.append('profile', profile);

            try {
                const res = await fetch('/api/audio-clean', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    log(`Cleaning complete! Download: ${data.downloadUrl}`, 'success');
                    showToast('Audio cleaned successfully', 'success');
                } else throw new Error(data.error);
            } catch (e) {
                log('Cleaning failed: ' + e.message, 'error');
            } finally {
                state.isProcessing = false;
            }
        });

        // Quality Lab
        document.getElementById('startQualityBtn').addEventListener('click', async () => {
            const file = document.getElementById('qualityFile').files[0];
            if (!file) return showToast('Please select an M4B file', 'error');

            const resultsDiv = document.getElementById('qualityResults');
            resultsDiv.style.display = 'block';
            resultsDiv.innerHTML = '<div style="color: var(--primary);">Analyzing quality...</div>';
            
            const formData = new FormData();
            formData.append('file', file);

            try {
                const res = await fetch('/api/verify-quality', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    resultsDiv.innerHTML = `<pre style="font-size: 0.8rem; color: var(--success); white-space: pre-wrap;">${data.result}</pre>`;
                } else throw new Error(data.error);
            } catch (e) {
                resultsDiv.innerHTML = `<div style="color: var(--error);">Analysis failed: ${e.message}</div>`;
            }
        });

        document.getElementById('getChecksumBtn').addEventListener('click', async () => {
            const file = document.getElementById('qualityFile').files[0];
            if (!file) return showToast('Please select a file', 'error');

            try {
                const formData = new FormData();
                formData.append('file', file);
                const res = await fetch('/api/checksum', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    showToast(`SHA256: ${data.checksum}`, 'info');
                    log(`Checksum: ${data.checksum}`, 'info');
                } else throw new Error(data.error);
            } catch (e) {
                showToast('Checksum failed: ' + e.message, 'error');
            }
        });

        // AI Assistants
        document.getElementById('ai-meta-btn').addEventListener('click', async () => {
            const title = elements.metaTitle.value;
            const author = elements.metaAuthor.value;
            const apiKey = elements.openRouterKey.value;
            const model = document.getElementById('aiModel').value;
            
            if (!title) return showToast('Please enter a title first', 'error');
            if (!apiKey) return showToast('Please provide an OpenRouter API Key', 'error');

            log('Requesting AI metadata generation...', 'info');
            try {
                const res = await fetch('/api/ai/metadata', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, author, apiKey, model })
                });
                const data = await res.json();
                if (data.error) throw new Error(data.error);

                elements.metaAuthor.value = data.author || author;
                elements.metaGenre.value = data.genre || '';
                elements.metaDescription.value = data.description || '';
                log('AI metadata updated successfully', 'success');
                showToast('Metadata auto-filled', 'success');
            } catch (e) {
                log('AI Metadata failed: ' + e.message, 'error');
            }
        });

        // --- History & Activity Management ---
        let activityHistory = JSON.parse(localStorage.getItem('production_history') || '[]');

        function saveToHistory(type, name, url) {
            const entry = {
                id: Date.now(),
                timestamp: new Date().toISOString(),
                type: type, // 'conversion', 'merge', 'cleaning', 'tts'
                name: name,
                url: url
            };
            activityHistory.unshift(entry);
            // Keep only last 50 items
            if (activityHistory.length > 50) activityHistory.pop();
            localStorage.setItem('production_history', JSON.stringify(activityHistory));
            renderActivity();
        }

        // --- 20 Advanced Non-AI Features ---

        function initAdvancedFeatures() {
            // 1. Sidebar Collapse
            const sidebar = document.querySelector('aside');
            const collapseBtn = document.getElementById('sidebarCollapseBtn');
            if (collapseBtn) {
                collapseBtn.onclick = () => {
                    sidebar.classList.toggle('collapsed');
                    document.querySelector('main').style.marginLeft = sidebar.classList.contains('collapsed') ? '80px' : '300px';
                };
            }

            // 2. Blur Intensity
            const blurSlider = document.getElementById('blurSlider');
            if (blurSlider) {
                blurSlider.oninput = (e) => {
                    document.documentElement.style.setProperty('--blur-intensity', e.target.value + 'px');
                };
            }

            // 3. Primary Color Picker
            const colorPicker = document.getElementById('primaryColorPicker');
            if (colorPicker) {
                colorPicker.oninput = (e) => {
                    document.documentElement.style.setProperty('--primary', e.target.value);
                    document.documentElement.style.setProperty('--primary-glow', e.target.value + '33');
                };
            }

            // 4. Activity Search
            const activitySearch = document.getElementById('activitySearch');
            if (activitySearch) {
                activitySearch.oninput = () => renderActivity(activitySearch.value.toLowerCase());
            }

            // 5. Download All
            const downloadAllBtn = document.getElementById('downloadAllBtn');
            if (downloadAllBtn) {
                downloadAllBtn.onclick = () => {
                    activityHistory.forEach(entry => {
                        const a = document.createElement('a');
                        a.href = entry.url;
                        a.download = entry.name;
                        a.click();
                    });
                    showToast(`Started ${activityHistory.length} downloads`, 'info');
                };
            }

            // 6. Export Log
            const exportLogBtn = document.getElementById('exportLogBtn');
            if (exportLogBtn) {
                exportLogBtn.onclick = () => {
                    const logText = Array.from(document.getElementById('processLog').children)
                        .map(l => `[${new Date().toISOString()}] ${l.textContent}`)
                        .join('\n');
                    const blob = new Blob([logText], { type: 'text/plain' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'production_log.txt';
                    a.click();
                };
            }

            // 7 & 8. Quick Switcher & Shortcuts
            window.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 'k') { e.preventDefault(); toggleModal('quickSwitcherModal'); }
                if (e.ctrlKey && e.key === 'b') { e.preventDefault(); if(collapseBtn) collapseBtn.click(); }
                if (e.key === '?') { toggleModal('shortcutsModal'); }
                if (e.key === 'Escape') closeAllModals();
            });

            // Quick Switcher Search
            const switcherInput = document.getElementById('quickSwitcherInput');
            const switcherResults = document.getElementById('quickSwitcherResults');
            const tools = [
                { name: 'Audiobook Pro', id: 'audiobook' },
                { name: 'Batch Merge', id: 'batch' },
                { name: 'Audio Format Switcher', id: 'converter' },
                { name: 'Audio Cleanup', id: 'clean' },
                { name: 'Production Activity', id: 'activity' }
            ];

            if (switcherInput) {
                switcherInput.oninput = () => {
                    const val = switcherInput.value.toLowerCase();
                    switcherResults.innerHTML = tools.filter(t => t.name.toLowerCase().includes(val))
                        .map(t => `<div class="manifest-item" style="cursor: pointer;" onclick="switchTool('${t.id}'); closeAllModals();">${t.name}</div>`)
                        .join('');
                };
            }

            // 9 & 10. Chapter Export/Import
            const exportChaptersBtn = document.getElementById('exportChaptersBtn');
            if (exportChaptersBtn) {
                exportChaptersBtn.onclick = () => {
                    const blob = new Blob([JSON.stringify(state.chapters, null, 2)], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'chapters_manifest.json';
                    a.click();
                };
            }

            const importChaptersBtn = document.getElementById('importChaptersBtn');
            if (importChaptersBtn) {
                importChaptersBtn.onclick = () => {
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = '.json';
                    input.onchange = async (e) => {
                        const text = await e.target.files[0].text();
                        state.chapters = JSON.parse(text);
                        renderManifest();
                        showToast('Manifest imported', 'success');
                    };
                    input.click();
                };
            }

            // 11. Project Auto-Save
            setInterval(() => {
                localStorage.setItem('bpm4b_project_state', JSON.stringify({
                    chapters: state.chapters,
                    activeTool: state.activeTool
                }));
            }, 10000);

            // 12. Batch Renamer
            const applyRenameBtn = document.getElementById('btn-apply-batch-rename');
            if (applyRenameBtn) {
                applyRenameBtn.onclick = () => {
                    const prefix = document.getElementById('renamePrefix').value;
                    const suffix = document.getElementById('renameSuffix').value;
                    batchFilesArray.forEach(file => {
                        const parts = file.name.split('.');
                        const ext = parts.pop();
                        file.name = `${prefix}${parts.join('.')}${suffix}.${ext}`;
                    });
                    renderBatchList();
                    showToast('Batch renamed', 'success');
                };
            }
            // 13. Waveform Zoom
            const zoomSlider = document.getElementById('waveformZoom');
            if (zoomSlider) {
                zoomSlider.oninput = (e) => {
                    if (wavesurfer) wavesurfer.zoom(Number(e.target.value));
                };
            }

            // 14. CSV / M3U Export
            const exportCSVBtn = document.getElementById('exportCSVBtn');
            if (exportCSVBtn) {
                exportCSVBtn.onclick = () => {
                    let csv = "Index,Title,Start,Duration\n";
                    state.chapters.forEach((c, i) => {
                        csv += `${i+1},"${c.title}",${c.start},${c.duration}\n`;
                    });
                    const blob = new Blob([csv], { type: 'text/csv' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'manifest.csv';
                    a.click();
                };
            }

            const exportM3UBtn = document.getElementById('exportM3UBtn');
            if (exportM3UBtn) {
                exportM3UBtn.onclick = () => {
                    let m3u = "#EXTM3U\n";
                    state.chapters.forEach(c => {
                        m3u += `#EXTINF:${Math.round(c.duration)},${c.title}\n`;
                        m3u += `${c.title}.mp3\n`;
                    });
                    const blob = new Blob([m3u], { type: 'text/plain' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'manifest.m3u';
                    a.click();
                };
            }

            // 15. AI Chapter Naming
            const aiChapterNamesBtn = document.getElementById('aiChapterNamesBtn');
            if (aiChapterNamesBtn) {
                aiChapterNamesBtn.onclick = async () => {
                    const apiKey = document.getElementById('openRouterKey').value;
                    if (!apiKey) return showToast('OpenRouter API Key required', 'warning');
                    if (!state.documentText) return showToast('Analyze document first', 'warning');

                    log('AI is naming your chapters...', 'info');
                    try {
                        const res = await fetch('/api/ai/metadata', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                apiKey, 
                                model: document.getElementById('aiModel').value,
                                text: state.documentText.substring(0, 5000),
                                field: 'chapter_names'
                            })
                        });
                        const data = await res.json();
                        if (data.names && data.names.length > 0) {
                            state.chapters.forEach((c, i) => {
                                if (data.names[i]) c.title = data.names[i];
                            });
                            renderManifest();
                            showToast('Chapters renamed by AI!', 'success');
                        }
                    } catch (e) {
                        log('AI Naming failed: ' + e.message, 'error');
                    }
                };
            }

            // 16. AI Voice Matcher
            const aiVoiceSuggestBtn = document.getElementById('aiVoiceSuggestBtn');
            if (aiVoiceSuggestBtn) {
                aiVoiceSuggestBtn.onclick = async () => {
                    const apiKey = document.getElementById('openRouterKey').value;
                    if (!apiKey) return showToast('OpenRouter API Key required', 'warning');
                    if (!state.documentText) return showToast('Load a document first', 'warning');

                    log('AI is matching voices to your story...', 'info');
                    try {
                        const res = await fetch('/api/ai/metadata', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                apiKey, 
                                model: document.getElementById('aiModel').value,
                                text: state.documentText.substring(0, 2000),
                                field: 'voice_match'
                            })
                        });
                        const data = await res.json();
                        if (data.suggestion) {
                            log('AI Recommendation: ' + data.suggestion, 'success');
                            showToast('Voice suggested in log', 'info');
                        }
                    } catch (e) { log('AI Suggest failed: ' + e.message, 'error'); }
                };
            }

            // 17. AI cover blurb, 18. Sentiment, 19. Hard Words
            ['aiBlurbBtn', 'aiSentimentBtn', 'aiHardWordsBtn'].forEach(id => {
                const btn = document.getElementById(id);
                if (!btn) return;
                btn.onclick = async () => {
                    const apiKey = document.getElementById('openRouterKey').value;
                    if (!apiKey) return showToast('API Key required', 'warning');
                    log(`AI is generating ${id.replace('ai', '').replace('Btn', '')}...`, 'info');
                    try {
                        const res = await fetch('/api/ai/metadata', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                apiKey, 
                                model: document.getElementById('aiModel').value,
                                text: state.documentText.substring(0, 5000),
                                field: id.replace('ai', '').replace('Btn', '').toLowerCase()
                            })
                        });
                        const data = await res.json();
                        if (data.result) {
                            log(`AI Result: ${data.result}`, 'success');
                            showToast('AI Task Complete', 'success');
                        }
                    } catch (e) { log('AI Task failed', 'error'); }
                };
            });

            // 20. Quality Shortcut
            window.setQuality = (q) => {
                const select = document.getElementById('audioQuality') || document.getElementById('m4bAudioQuality') || document.getElementById('converterQuality');
                if (select) {
                    select.value = q;
                    showToast(`Bitrate set to ${q}`, 'info');
                }
            };
        }

        function toggleModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.toggle('hidden');
        }

        function closeAllModals() {
            document.querySelectorAll('.modal-overlay').forEach(m => m.classList.add('hidden'));
        }

        // --- Updated renderActivity to support search ---
        function renderActivity(query = '') {
            const list = document.getElementById('activityList');
            if (!list) return;

            const filtered = query 
                ? activityHistory.filter(e => e.name.toLowerCase().includes(query))
                : activityHistory;

            if (filtered.length === 0) {
                list.innerHTML = `<div style="padding: 2rem; text-align: center; color: var(--text-muted);">No matching activity.</div>`;
                return;
            }

            list.innerHTML = filtered.map(entry => {
                const date = new Date(entry.timestamp).toLocaleString();
                const icon = getEntryIcon(entry.type);
                return `
                <div class="manifest-item" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; margin-bottom: 0.75rem; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div class="card-icon-sm" style="width: 36px; height: 36px; background: rgba(255,255,255,0.05);">
                            ${icon}
                        </div>
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-weight: 600; font-size: 0.9rem;">${entry.name}</span>
                            <span style="font-size: 0.7rem; color: var(--text-muted);">${date} • ${entry.type.toUpperCase()}</span>
                        </div>
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <a href="${entry.url}" download="${entry.name}" class="btn btn-secondary btn-sm" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">Download</a>
                        <button class="btn btn-sm" style="color: var(--error); padding: 0.4rem;" onclick="removeFromHistory(${entry.id})">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>
                `;
            }).join('');
        }

        function getEntryIcon(type) {
            switch (type) {
                case 'merge': return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/><path d="m15 5 3 3-3 3M9 13l-3 3 3 3"/></svg>';
                case 'cleaning': return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v19M5 8h14M8 13h8M11 18h2"/></svg>';
                case 'tts': return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>';
                default: return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>';
            }
        }

        window.removeFromHistory = (id) => {
            activityHistory = activityHistory.filter(e => e.id !== id);
            localStorage.setItem('production_history', JSON.stringify(activityHistory));
            renderActivity();
        };

        const clearHistoryBtn = document.getElementById('clearHistoryBtn');
        if (clearHistoryBtn) {
            clearHistoryBtn.onclick = () => {
                if (confirm('Clear all production history?')) {
                    activityHistory = [];
                    localStorage.removeItem('production_history');
                    renderActivity();
                }
            };
        }

        // Initial render
        renderActivity();

        // Handle file inputs for new tools
        ['cloneRef', 'cloneSource', 'clean', 'quality'].forEach(prefix => {
            const dropZone = document.getElementById(prefix + 'DropZone');
            const fileInput = document.getElementById(prefix + 'File');
            const fileInfo = document.getElementById(prefix + 'FileInfo');

            if (dropZone) {
                dropZone.onclick = () => fileInput.click();
                fileInput.onchange = () => {
                    if (fileInput.files[0]) {
                        fileInfo.classList.remove('hidden');
                        fileInfo.textContent = 'File: ' + fileInput.files[0].name;
                    }
                };
            }
        });

        // --- Bootstrap ---
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>

</html>