        async function handleAudiobookGeneration() {
            console.log('[BPM4B] handleAudiobookGeneration clicked');
            const fileInput = elements.docFile;
            if (!fileInput.files.length) return showToast('Select document', 'error');

            const jobId = 'job_' + Date.now();
            state.activeJobId = jobId;
            startPipeline(jobId);
            log('Initializing Kokoro Local TTS... (parallel mode enabled)', 'info');

            // Show stop button
            const stopBtn = document.getElementById('stopGenerationBtn');
            if (stopBtn) { stopBtn.classList.remove('hidden'); stopBtn.disabled = false; stopBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 0.5rem;"><rect x="4" y="4" width="16" height="16" rx="2"/></svg> Stop Generation'; }

            const formData = new FormData();
            formData.append('document_file', fileInput.files[0]);
            formData.append('voice', document.getElementById('ttsVoice').value);
            formData.append('speed', document.getElementById('ttsSpeed').value);
            formData.append('jobId', jobId);

            // Multi-Voice settings
            if (document.getElementById('enableMultiVoice').checked) {
                formData.append('multi_voice', 'true');
                formData.append('dialogue_voice', document.getElementById('dialogueVoice').value);
            }

            // Pro Output settings
            if (document.getElementById('announceChapters').checked) {
                formData.append('announce_chapters', 'true');
            }

            // Add metadata
            const metadata = {
                title: elements.metaTitle.value,
                author: elements.metaAuthor.value,
                genre: elements.metaGenre.value,
                description: elements.metaDescription.value
            };
            formData.append('metadata', JSON.stringify(metadata));

            if (state.coverBase64) {
                formData.append('cover_base64', state.coverBase64);
            }

            const selectedChapters = state.chapters.filter(c => c.selected !== false);
            if (selectedChapters.length > 0) {
                formData.append('chapters', JSON.stringify(selectedChapters.map(c => ({
                    title: c.title,
                    originalIndex: c.originalIndex
                }))));
            }
            if (selectedChapters.length === 0 && state.chapters.length > 0) {
                return showToast('Please select at least one chapter', 'error');
            }

            try {
                const res = await fetch('/api/document-to-audiobook', { method: 'POST', body: formData });

                const contentType = res.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    const data = await res.json();
                    if (!res.ok || data.error) {
                        throw new Error(data.error || `Server error ${res.status}`);
                    }

                    // The backend returned JSON indicating generation started asynchronously.
                    // SSE will report progress and eventually provide a downloadUrl.
                    return;
                }

                if (!res.ok) {
                    const errData = await res.json().catch(() => ({}));
                    throw new Error(errData.error || `Server error ${res.status}`);
                }

                // Fallback for legacy synchronous generation
                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = (elements.metaTitle.value || 'audiobook') + '.mp3';
                document.body.appendChild(a);
                a.click();
                a.remove();

                showToast('Audiobook generated successfully!', 'success');
            } catch (e) {
                if (e.message === 'CANCELLED' || (e.message && e.message.includes('CANCELLED'))) {
                    log('Generation stopped by user.', 'info');
                    showToast('Generation stopped', 'info');
                    state.isProcessing = false;
                    const stopBtn = document.getElementById('stopGenerationBtn');
                    if (stopBtn) stopBtn.classList.add('hidden');
                } else {
                    failPipeline(e.message);
                }
            }
        }

        async function handlePreviewChapters() {
            const fileInput = document.getElementById('docFile');
            if (!fileInput.files.length) return showToast('Select document', 'error');

            log('Scanning document structure...', 'info');
            
            // Mock 3-pass progress for immediate user feedback
            log('Analyzing 1 out of 3: Document structure analysis...', 'info');
            await new Promise(resolve => setTimeout(resolve, 800));
            log('Analyzing 2 out of 3: Extracting context and verifying boundaries...', 'info');
            await new Promise(resolve => setTimeout(resolve, 1200));
            log('Analyzing 3 out of 3: Refining chapter structure and normalizing content...', 'info');
            await new Promise(resolve => setTimeout(resolve, 800));

            const formData = new FormData();
            formData.append('document_file', fileInput.files[0]);

            try {
                const res = await fetch('/api/preview-chapters', { method: 'POST', body: formData });
                const data = await res.json();

                if (!res.ok) {
                    throw new Error(data.error || 'Analysis failed');
                }

                state.chapters = data.chapters.map((c, i) => {
                    // Strip progress strings like "-- fourteen of one hundred sixteen --" or "-- 14 of 116 --"
                    const cleanedTitle = c.title.replace(/-- .* of .* --/g, '').trim() || `Chapter ${i + 1}`;
                    return {
                        id: Date.now() + i,
                        originalIndex: i,
                        title: cleanedTitle,
                        type: c.type,
                        content: c.content, 
                        preview: c.preview,
                        endPreview: c.endPreview,
                        selected: true,
                        duration: 0,
                        startTime: 0
                    };
                });
                renderManifest();
                showToast(`3-pass analysis complete: ${data.chapters.length} chapters detected`, 'success');
            } catch (e) {
                const errorMsg = e.message || 'Analysis failed';
                log('Analysis failed: ' + errorMsg, 'error');
                showToast('Analysis failed: ' + errorMsg, 'error');
            }
        }

        async function handleDetectSilence() {
            const fileInput = document.getElementById('sourceFile');
            if (!fileInput.files.length) return showToast('Select an MP3 in standard conversion to detect silence', 'warning');

            log('Scanning audio for silence...', 'info');
            const formData = new FormData();
            formData.append('audio_file', fileInput.files[0]);

            try {
                const res = await fetch('/api/detect-silence', { method: 'POST', body: formData });
                const data = await res.json();

                if (data.silences && data.silences.length > 0) {
                    state.chapters = [];
                    let lastEnd = 0;
                    data.silences.forEach((s, i) => {
                        state.chapters.push({
                            id: Date.now() + i,
                            title: `Chapter ${i + 1}`,
                            startTime: lastEnd,
                            duration: s.start - lastEnd
                        });
                        lastEnd = s.end;
                    });
                    // Add final chapter
                    state.chapters.push({
                        id: Date.now() + 999,
                        title: `Final Chapter`,
                        startTime: lastEnd,
                        duration: 0 // Will need to be set or estimated
                    });

                    state.cumulativeTime = lastEnd;
                    renderManifest();
                    showToast(`Detected ${data.silences.length + 1} potential chapters`, 'success');
                } else {
                    showToast('No silence detected with current settings', 'warning');
                }
            } catch (e) {
                log('Silence detection failed', 'error');
            }
        }

