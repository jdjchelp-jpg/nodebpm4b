        function parseDuration(input) {
            if (!input) return null;
            // Support formats like HH:MM:SS.mmm, MM:SS.mmm, SS.mmm
            if (input.includes(':') || input.includes('.')) {
                let parts = input.split(':').map(p => p.trim());
                let totalSeconds = 0;

                // Handle MM:SS or HH:MM:SS
                if (parts.length === 3) {
                    totalSeconds += parseFloat(parts[0]) * 3600; // hours
                    totalSeconds += parseFloat(parts[1]) * 60;   // minutes
                    totalSeconds += parseFloat(parts[2]);        // seconds + ms
                } else if (parts.length === 2) {
                    totalSeconds += parseFloat(parts[0]) * 60;   // minutes
                    totalSeconds += parseFloat(parts[1]);        // seconds + ms
                } else if (parts.length === 1 && input.includes('.')) {
                    totalSeconds += parseFloat(parts[0]);        // just seconds + ms
                }

                return isNaN(totalSeconds) ? null : totalSeconds;
            }

            const num = parseFloat(input);
            return isNaN(num) ? null : num * 60; // Default to minutes if just a number
        }

        function parsePastedChapters(text) {
            const chapters = [];
            const lines = text.split('\n').map(line => line.trim()).filter(line => line);

            for (const line of lines) {
                // Support formats like:
                // "The Young Warriors = 1h 43m 02s"
                // "My Father Sun Sun Johnson = 1h 30m 10s"
                // "The Enchanted Island = 1h 01m 51s"
                // Also support: "Title: Duration" or "Title - Duration"
                const match = line.match(/^(.+?)\s*[=:–-]\s*(.+)$/);
                if (match) {
                    const title = match[1].trim();
                    const durationStr = match[2].trim();

                    // Parse duration string like "1h 43m 02s" or "1h 30m 10s"
                    const duration = parseDurationString(durationStr);
                    if (duration !== null && duration > 0) {
                        chapters.push({ title, duration });
                    }
                }
            }

            return chapters;
        }

        function parseDurationString(str) {
            // Parse formats like "1h 43m 02s", "1h 30m 10s", "1h 01m 51s"
            // Also support "1:43:02", "90:30", "5430" (seconds)

            str = str.trim().toLowerCase();

            // Try to parse "Xh Ym Zs" format
            const hmsMatch = str.match(/(?:(\d+)h\s*)?(?:(\d+)m\s*)?(?:(\d+(?:\.\d+)?)s)?/);
            if (hmsMatch) {
                const hours = parseInt(hmsMatch[1]) || 0;
                const minutes = parseInt(hmsMatch[2]) || 0;
                const seconds = parseFloat(hmsMatch[3]) || 0;

                if (hours > 0 || minutes > 0 || seconds > 0) {
                    return hours * 3600 + minutes * 60 + seconds;
                }
            }

            // Try to parse "HH:MM:SS" or "MM:SS" format
            if (str.includes(':')) {
                const parts = str.split(':').map(p => parseFloat(p.trim()));
                if (parts.length === 3) {
                    return parts[0] * 3600 + parts[1] * 60 + parts[2];
                } else if (parts.length === 2) {
                    return parts[0] * 60 + parts[1];
                }
            }

            // Try to parse as plain number (seconds)
            const num = parseFloat(str);
            if (!isNaN(num) && num > 0) {
                return num;
            }

            return null;
        }

        function viewFullText(id) {
            const ch = state.chapters.find(c => c.id == id);
            if (!ch) return;

            state.currentViewingId = id;
            document.getElementById('modalTitle').textContent = `Editing: ${ch.type || 'Chapter'} ${ch.number || ''}: ${ch.title}`;
            document.getElementById('modalContent').innerText = ch.content; // Use innerText for plain text editing
            document.getElementById('textViewerModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function saveChapterText() {
            const id = state.currentViewingId;
            const ch = state.chapters.find(c => c.id == id);
            if (!ch) return;

            const newContent = document.getElementById('modalContent').innerText.trim();
            if (!newContent) return showToast('Chapter content cannot be empty', 'error');

            ch.content = newContent;
            ch.contentLength = newContent.length;
            ch.wordCount = newContent.split(/\s+/).length;
            
            // Re-calculate previews
            ch.preview = newContent.substring(0, 500) + (newContent.length > 500 ? '...' : '');
            ch.endPreview = newContent.length > 500 ? '...' + newContent.substring(newContent.length - 500) : '';

            renderManifest();
            showToast('Changes saved locally', 'success');
            closeModal();
        }

        function mergeWithNext(id) {
            const idx = state.chapters.findIndex(c => c.id == id);
            if (idx === -1 || idx === state.chapters.length - 1) return;

            const current = state.chapters[idx];
            const next = state.chapters[idx + 1];

            // Merge content and update metadata
            current.content += '\n\n' + next.content;
            current.contentLength = current.content.length;
            current.wordCount = current.content.split(/\s+/).length;
            current.preview = current.content.substring(0, 500) + (current.content.length > 500 ? '...' : '');
            current.endPreview = current.content.length > 500 ? '...' + current.content.substring(current.content.length - 500) : '';

            // Remove next chapter
            state.chapters.splice(idx + 1, 1);
            
            renderManifest();
            showToast('Chapters merged', 'success');
        }

        function closeModal() {
            document.getElementById('textViewerModal').classList.add('hidden');
            document.body.style.overflow = '';
        }

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        function removeChapter(id) {
            const idx = state.chapters.findIndex(c => c.id === id);
            if (idx === -1) return;

            state.chapters.splice(idx, 1);
            // Re-calculate all subsequent start times
            state.cumulativeTime = 0;
            state.chapters = state.chapters.map(ch => {
                const updated = { ...ch, startTime: state.cumulativeTime };
                state.cumulativeTime += ch.duration;
                return updated;
            });

            renderManifest();
            showToast('Chapter removed', 'info');
            elements.nextTimestamp.textContent = formatTime(state.cumulativeTime);
        }

