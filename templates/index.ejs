<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BPM4B v12 | Ultimate Production Suite</title>
    <script src="https://unpkg.com/wavesurfer.js@7"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.4);
            --accent: #8b5cf6;
            --success: #10b981;
            --error: #ef4444;
            --warning: #f59e0b;
            --border: rgba(255, 255, 255, 0.05);
            --border-hover: rgba(255, 255, 255, 0.12);
            --glass-bg: rgba(30, 41, 59, 0.7);
            --glass-border: rgba(255, 255, 255, 0.08);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 20px;
            --radius-xl: 32px;
            --font-main: 'Outfit', sans-serif;
            --font-body: 'Inter', sans-serif;
            --sidebar-width: 280px;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;

            /* Theme colors - Mesh Gradient logic */
            --bg-app: #020617;
            --bg-surface: #0f172a;
            --slate-50: #0f172a;
            --slate-100: #1e293b;
            --slate-200: #334155;
            --slate-300: #475569;
            --slate-400: #64748b;
            --slate-500: #94a3b8;
            --slate-600: #cbd5e1;
            --slate-700: #e2e8f0;
            --slate-800: #f1f5f9;
            --slate-900: #f8fafc;
        }

        [data-theme="light"] {
            --bg-page: #f8fafc;
            --bg-sidebar: #ffffff;
            --bg-card: #ffffff;
            --bg-card-hover: #f1f5f9;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #94a3b8;
            --border: rgba(0, 0, 0, 0.06);
            --border-hover: rgba(0, 0, 0, 0.1);
            --slate-900: #0f172a;
        }

        [data-theme="light"] .log-vessel {
            color: #334155;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--bg-app);
            color: var(--slate-900);
            min-height: 100vh;
            display: flex;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Layout Structure */
        .app-shell {
            display: flex;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--bg-surface);
            border-right: 1px solid var(--slate-200);
            display: flex;
            flex-direction: column;
            padding: 2rem 1.5rem;
            z-index: 50;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Sidebar Scrollbar */
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: var(--slate-200);
            border-radius: 10px;
        }

        .sidebar.collapsed {
            width: 80px;
            padding: 2rem 0.75rem;
        }

        .sidebar.collapsed .logo-text,
        .sidebar.collapsed .nav-label,
        .sidebar.collapsed .nav-item span,
        .sidebar.collapsed .version-tag,
        .sidebar.collapsed .theme-toggle-container label,
        .sidebar.collapsed .input-group label {
            display: none;
        }

        .sidebar.collapsed .nav-item {
            justify-content: center;
            padding: 0.75rem;
        }

        .sidebar.collapsed .nav-group {
            align-items: center;
        }

        .sidebar.collapsed #sidebarCollapseBtn svg {
            transform: rotate(180deg);
        }
        .main-content {
            flex: 1;
            overflow-y: auto;
            position: relative;
            padding: 2.5rem;
            background-color: var(--bg-app);
            background-image: 
                radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--primary) 8%, transparent) 0%, transparent 50%),
                radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--accent) 8%, transparent) 0%, transparent 50%);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-app);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--slate-100);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--slate-200);
        }

        /* Brand section */
        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 3rem;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px var(--primary-glow);
        }

        .brand h1 {
            font-family: var(--font-main);
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: var(--slate-900);
        }

        /* Navigation */
        .nav-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 2rem;
        }

        .nav-label {
            font-family: var(--font-main);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--slate-400);
            margin-bottom: 0.5rem;
            padding-left: 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: var(--radius-md);
            color: var(--slate-600);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9375rem;
            transition: all 0.2s ease;
            cursor: pointer;
            border: 1px solid transparent;
        }

        .nav-item:hover {
            color: var(--slate-900);
            background: var(--slate-100);
        }

        .nav-item.active {
            color: var(--primary);
            background: color-mix(in srgb, var(--primary) 10%, transparent);
            border-color: color-mix(in srgb, var(--primary) 20%, transparent);
        }

        .nav-item svg {
            width: 20px;
            height: 20px;
            opacity: 0.7;
        }

        .nav-item.active svg {
            opacity: 1;
            stroke: var(--primary);
        }

        /* Version & Theme switch at bottom */
        .sidebar-footer {
            margin-top: auto;
            border-top: 1px solid var(--border);
            padding-top: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .version-tag {
            font-size: 0.75rem;
            color: var(--slate-400);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .theme-toggle-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--slate-600);
        }

        /* Bento Dashboard Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            grid-auto-rows: minmax(120px, auto);
            gap: 1.5rem;
            max-width: 1440px;
            margin: 0 auto;
        }

        .bento-card {
            background: var(--glass-bg);
            backdrop-filter: blur(var(--blur-intensity, 12px));
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .bento-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
        }

        .bento-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-4px) scale(1.005);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
            background: rgba(30, 41, 59, 0.8);
        }

        /* Span Helpers */
        .col-span-full {
            grid-column: span 12;
        }

        .col-span-8 {
            grid-column: span 8;
        }

        .col-span-4 {
            grid-column: span 4;
        }

        .col-span-6 {
            grid-column: span 6;
        }

        .row-span-2 {
            grid-row: span 2;
        }

        .row-span-3 {
            grid-row: span 3;
        }

        @media (max-width: 1024px) {

            .col-span-8,
            .col-span-4,
            .col-span-6 {
                grid-column: span 12;
            }
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .card-title {
            font-family: var(--font-main);
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--slate-900);
            display: flex;
            align-items: center;
            gap: 0.875rem;
        }

        .card-icon-sm {
            width: 36px;
            height: 36px;
            background: color-mix(in srgb, var(--primary) 10%, transparent);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
        }

        /* Tool views */
        .tool-content {
            display: none;
            animation: fadeIn 0.5s ease-out;
        }

        .tool-content.active {
            display: contents;
            /* Allows children to participate in the dashboard-grid */
        }

        /* Inputs & Controls */
        .input-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--slate-400);
            margin-bottom: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .form-select,
        .form-input,
        textarea {
            width: 100%;
            background: var(--slate-100);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            padding: 0.875rem 1.125rem;
            color: var(--slate-900);
            font-family: var(--font-body);
            font-size: 0.9375rem;
            transition: all 0.2s ease;
        }

        .form-select:focus,
        .form-input:focus,
        textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 15%, transparent);
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        /* Drop Zone */
        .drop-zone {
            border: 2px dashed var(--slate-300);
            border-radius: var(--radius-lg);
            padding: 3.5rem 2rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            background: color-mix(in srgb, var(--slate-100) 50%, transparent);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .drop-zone:hover,
        .drop-zone.drag-over {
            border-color: var(--primary);
            background: color-mix(in srgb, var(--primary) 4%, transparent);
            transform: scale(1.005);
        }

        .drop-zone-icon {
            width: 48px;
            height: 48px;
            color: var(--primary);
            opacity: 0.9;
        }

        .drop-zone p {
            font-weight: 600;
            font-size: 1rem;
            color: var(--slate-700);
        }

        .drop-zone span {
            font-size: 0.8125rem;
            color: var(--slate-400);
        }

        .active-file-indicator {
            margin-top: 1.5rem;
            padding: 1rem 1.25rem;
            background: color-mix(in srgb, var(--success) 10%, transparent);
            border: 1px solid color-mix(in srgb, var(--success) 20%, transparent);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.875rem;
            color: var(--success);
            font-weight: 600;
        }

        /* Engine Status Widget */
        .engine-status-card {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .status-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 0.375rem 0.875rem;
            border-radius: 999px;
        }

        .status-ready {
            background: color-mix(in srgb, var(--success) 10%, transparent);
            color: var(--success);
        }

        .status-loading {
            background: color-mix(in srgb, var(--warning) 10%, transparent);
            color: var(--warning);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            padding: 1rem 1.5rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            font-size: 0.9375rem;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            width: 100%;
            font-family: var(--font-main);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white;
            box-shadow: 0 4px 15px color-mix(in srgb, var(--primary) 30%, transparent);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px color-mix(in srgb, var(--primary) 45%, transparent);
        }

        .btn-secondary {
            background: var(--slate-100);
            color: var(--slate-900);
            border: 1px solid var(--slate-200);
        }

        /* Progress Display */
        .progress-card {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .progress-bar-container {
            height: 8px;
            background: var(--slate-200);
            border-radius: 4px;
            overflow: hidden;
            border: 1px solid var(--slate-300);
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(to right, var(--primary), var(--accent));
            width: 0%;
            transition: width 0.4s ease-out;
            position: relative;
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            animation: shimmer 1.5s infinite;
        }

        /* Log view */
        .log-vessel {
            background: rgba(0, 0, 0, 0.25);
            border-radius: var(--radius-md);
            padding: 1rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-muted);
            height: 150px;
            overflow-y: auto;
            border: 1px solid var(--border);
        }

        .log-line {
            margin-bottom: 0.25rem;
            border-left: 2px solid transparent;
            padding-left: 0.5rem;
        }

        .log-line.info {
            border-color: var(--primary);
        }

        .log-line.success {
            border-color: var(--success);
            color: var(--text-primary);
        }

        /* Chapter Preview Grid */
        .chapter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 0.5rem;
        }

        /* Reorder handles */
        .reorder-handle { cursor: grab; color: var(--slate-400); padding: 0.25rem; }
        .reorder-handle:active { cursor: grabbing; }

        .chapter-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 1rem;
            transition: all 0.2s ease;
        }

        .chapter-card:hover {
            border-color: var(--primary);
            background: rgba(255, 255, 255, 0.04);
        }

        .chapter-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .chapter-badge {
            background: var(--primary);
            color: white;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 800;
        }

        .chapter-name {
            font-weight: 700;
            font-size: 0.875rem;
        }

        /* Quick Entry Styles */
        .quick-entry-bar {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 1rem;
            padding: 1.25rem;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid var(--border);
            align-items: center;
            animation: fadeIn 0.3s ease;
        }

        .quick-entry-bar.hidden {
            display: none;
        }

        .entry-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .next-mark {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
            background: rgba(0, 0, 0, 0.2);
            padding: 0.25rem 0.6rem;
            border-radius: 4px;
        }

        .remove-ch {
            opacity: 0;
            transition: opacity 0.2s;
            color: var(--error);
            cursor: pointer;
            padding: 4px;
        }

        .chapter-card:hover .remove-ch {
            opacity: 1;
        }

        .chapter-card.deselected {
            opacity: 0.5;
            background: rgba(0, 0, 0, 0.1);
            filter: grayscale(1);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .modal-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .modal-content {
            width: 90%;
            max-width: 800px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            animation: slideIn 0.3s ease;
        }

        .modal-body {
            overflow-y: auto;
            padding: 1.5rem;
            line-height: 1.8;
            font-size: 1rem;
            color: var(--text-secondary);
            background: rgba(0, 0, 0, 0.2);
            border-radius: 12px;
        }

        .text-word-to-word {
            white-space: pre-wrap;
            word-wrap: break-word;
            font-family: 'Inter', sans-serif;
        }

        @keyframes slideIn {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Paste Chapters Panel */
        .paste-chapters-panel {
            background: rgba(99, 102, 241, 0.05);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: var(--radius-md);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            animation: fadeIn 0.3s ease;
        }

        .paste-chapters-panel.hidden {
            display: none;
        }

        .paste-chapters-panel textarea {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            line-height: 1.6;
        }

        .paste-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            margin-top: 1rem;
        }

        @keyframes shimmer {
            from {
                transform: translateX(-100%);
            }

            to {
                transform: translateX(100%);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.6;
            }

            100% {
                opacity: 1;
            }
        }

        /* Toast notifications */
        .toast-container {
            position: fixed;
            top: 2rem;
            right: 2rem;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .toast {
            background: var(--bg-card);
            border: 1px solid var(--border);
            padding: 1.25rem 2rem;
            border-radius: var(--radius-md);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 1rem;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .hidden {
            display: none !important;
        }

        /* Progress Bar Premium */
        .progress-bar-container {
            width: 100%;
            height: 12px;
            background: var(--slate-100);
            border-radius: 6px;
            overflow: hidden;
            margin: 1.5rem 0;
            border: 1px solid var(--border);
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 6px;
            transition: width 0.6s cubic-bezier(0.65, 0, 0.35, 1);
            position: relative;
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.3),
                transparent
            );
            animation: shimmer 2s infinite linear;
        }

        @keyframes shimmer {
            from { transform: translateX(-100%); }
            to { transform: translateX(100%); }
        }

        /* Status Indicator Pulse */
        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            position: relative;
            display: inline-block;
        }

        .status-indicator::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: inherit;
            animation: ring-pulse 2s infinite;
            top: 0;
            left: 0;
        }

        @keyframes ring-pulse {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(3.5); opacity: 0; }
        }

        .status-indicator.ready { background: var(--success); }
        .status-indicator.processing { background: var(--primary); }
        .status-indicator.error { background: var(--error); }
    </style>
</head>

