        function setupListeners() {
            console.log('[BPM4B] Setting up listeners...');

            // MP3 Conversion
            const btnConvert = document.getElementById('convertBtn') || document.getElementById('convertMp3Btn');
            if (btnConvert) btnConvert.addEventListener('click', handleMp3Conversion);

            // M4B Extraction
            const btnConvertM4b = document.getElementById('convertM4bBtn');
            if (btnConvertM4b) btnConvertM4b.addEventListener('click', handleM4bExtraction);

            // Audiobook Generation
            const btnGenerate = document.getElementById('generateAudiobookBtn');
            if (btnGenerate) btnGenerate.addEventListener('click', handleAudiobookGeneration);

            // Stop Generation
            const btnStop = document.getElementById('stopGenerationBtn');
            if (btnStop) btnStop.addEventListener('click', async () => {
                const jobId = state.activeJobId;
                if (!jobId) return;
                btnStop.disabled = true;
                btnStop.textContent = 'Stopping...';
                try {
                    await fetch('/api/cancel-job', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ jobId })
                    });
                    showToast('Stop signal sent — generation will halt after the current chunk', 'info');
                } catch (e) {
                    showToast('Failed to send stop signal', 'error');
                }
            });

            // Chapter Preview
            const btnPreviewChapters = document.getElementById('previewChaptersBtn');
            if (btnPreviewChapters) btnPreviewChapters.addEventListener('click', handlePreviewChapters);

            // Silence Detection
            const btnDetectSilence = document.getElementById('detectSilenceBtn');
            if (btnDetectSilence) btnDetectSilence.addEventListener('click', handleDetectSilence);
        }

        async function initializeVoices() {
            try {
                const res = await fetch('/api/voices');
                const data = await res.json();

                const selects = [document.getElementById('ttsVoice'), document.getElementById('dialogueVoice')];
                selects.forEach(s => {
                    if (!s) return;
                    s.innerHTML = ''; // Clear loading state

                    data.voices.forEach(v => {
                        const opt = document.createElement('option');
                        opt.value = v.id;
                        opt.textContent = `${v.lang} ${v.name}`;
                        if (v.id === 'af_heart') opt.selected = true;
                        s.appendChild(opt);
                    });
                });

                log('Professional voice list loaded', 'success');
            } catch (e) {
                log('Failed to load voices: ' + e.message, 'error');
            }
        }

        function initMetadataHandlers() {
            if (!elements.metaLookupBtn || !elements.coverDropZone || !elements.coverUpload) return;
            elements.metaLookupBtn.addEventListener('click', async () => {
                const title = elements.metaTitle.value.trim();
                if (!title) return showToast('Enter a title to search', 'warning');

                elements.metaLookupBtn.disabled = true;
                elements.metaLookupBtn.innerHTML = '<svg class="animate-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';

                try {
                    const res = await fetch(`/api/metadata/lookup?title=${encodeURIComponent(title)}`);
                    const data = await res.json();

                    if (data.error) throw new Error(data.error);

                    elements.metaTitle.value = data.title || title;
                    elements.metaAuthor.value = data.author || '';
                    elements.metaGenre.value = data.genre || '';
                    elements.metaDescription.value = data.description || '';

                    if (data.coverUrl) {
                        elements.coverPreview.innerHTML = `<img src="${data.coverUrl}" style="width: 100%; height: 100%; object-fit: cover;">`;
                        // Optionally fetch image and convert to blob/base64 for embedding later
                    }

                    showToast('Metadata fetched!', 'success');
                } catch (e) {
                    showToast('Lookup failed: ' + e.message, 'error');
                } finally {
                    elements.metaLookupBtn.disabled = false;
                    elements.metaLookupBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg> Auto-Fill';
                }
            });

            elements.coverDropZone.addEventListener('click', () => elements.coverUpload.click());
            elements.coverUpload.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) handleCoverFile(file);
            });

            elements.coverDropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                elements.coverDropZone.classList.add('drag-over');
            });

            elements.coverDropZone.addEventListener('dragleave', () => {
                elements.coverDropZone.classList.remove('drag-over');
            });

            elements.coverDropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                elements.coverDropZone.classList.remove('drag-over');
                const file = e.dataTransfer.files[0];
                if (file && file.type.startsWith('image/')) handleCoverFile(file);
            });

            // M4B Metadata Upload handlers
            if (elements.m4bMetadataDropZone && elements.m4bMetadataUpload) {
                elements.m4bMetadataDropZone.addEventListener('click', () => elements.m4bMetadataUpload.click());

                elements.m4bMetadataUpload.addEventListener('change', (e) => {
                    const file = e.target.files[0];
                    if (file) handleM4bMetadataFile(file);
                });

                elements.m4bMetadataDropZone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    elements.m4bMetadataDropZone.classList.add('drag-over');
                });

                elements.m4bMetadataDropZone.addEventListener('dragleave', () => {
                    elements.m4bMetadataDropZone.classList.remove('drag-over');
                });

                elements.m4bMetadataDropZone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    elements.m4bMetadataDropZone.classList.remove('drag-over');
                    const file = e.dataTransfer.files[0];
                    if (file && (file.name.endsWith('.m4b') || file.name.endsWith('.m4a'))) {
                        handleM4bMetadataFile(file);
                    }
                });

                if (elements.clearM4bMetadata) {
                    elements.clearM4bMetadata.addEventListener('click', () => {
                        state.m4bMetadataFile = null;
                        elements.m4bMetadataUpload.value = '';
                        elements.m4bMetadataFileInfo.classList.add('hidden');
                        showToast('M4B file cleared', 'info');
                    });
                }
            }

            // Apply Metadata to M4B button handler
            if (elements.btnApplyMetadata) {
                elements.btnApplyMetadata.addEventListener('click', async () => {
                    if (!state.m4bMetadataFile) {
                        showToast('Please upload an M4B file first', 'warning');
                        return;
                    }

                    const metadata = {
                        title: elements.metaTitle.value.trim(),
                        author: elements.metaAuthor.value.trim(),
                        genre: elements.metaGenre.value.trim(),
                        description: elements.metaDescription.value.trim()
                    };

                    if (!metadata.title && !metadata.author && !metadata.genre && !metadata.description) {
                        showToast('Please enter at least one metadata field', 'warning');
                        return;
                    }

                    elements.btnApplyMetadata.disabled = true;
                    elements.btnApplyMetadata.innerHTML = '<svg class="animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Applying...';

                    const formData = new FormData();
                    formData.append('file', state.m4bMetadataFile);
                    formData.append('metadata', JSON.stringify(metadata));
                    if (state.coverBase64) formData.append('cover_base64', state.coverBase64);

                    try {
                        const res = await fetch('/api/metadata/apply', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await res.json();

                        if (data.error) throw new Error(data.error);

                        showToast('Metadata applied successfully!', 'success');

                        // Trigger download
                        if (data.downloadUrl) {
                            const a = document.createElement('a');
                            a.href = data.downloadUrl;
                            a.download = data.filename || 'updated_metadata.m4b';
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                        }
                    } catch (e) {
                        showToast('Failed to apply metadata: ' + e.message, 'error');
                    } finally {
                        elements.btnApplyMetadata.disabled = false;
                        elements.btnApplyMetadata.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg> Apply Metadata to M4B';
                    }
                });
            }
        }

        async function handleM4bMetadataFile(file) {
            if (!file.name.endsWith('.m4b') && !file.name.endsWith('.m4a')) {
                showToast('Please upload an M4B or M4A file', 'error');
                return;
            }

            state.m4bMetadataFile = file;
            elements.m4bMetadataFileName.textContent = file.name;
            elements.m4bMetadataFileInfo.classList.remove('hidden');

            showToast('Loading metadata from ' + file.name + '...', 'info');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const res = await fetch('/api/metadata/extract', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();

                if (data.error) throw new Error(data.error);

                if (data.title) elements.metaTitle.value = data.title;
                if (data.author) elements.metaAuthor.value = data.author;
                if (data.genre) elements.metaGenre.value = data.genre;
                if (data.description) elements.metaDescription.value = data.description;

                if (data.coverBase64) {
                    state.coverBase64 = data.coverBase64;
                    elements.coverPreview.innerHTML = `<img src="${data.coverBase64}" style="width: 100%; height: 100%; object-fit: cover;">`;
                }

                showToast('Metadata loaded successfully!', 'success');
            } catch (e) {
                showToast('Failed to load metadata: ' + e.message, 'error');
            }
        }

        function handleCoverFile(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                state.coverBase64 = e.target.result;
                elements.coverPreview.innerHTML = `<img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: cover;">`;
                showToast('Cover updated', 'success');
            };
            reader.readAsDataURL(file);
        }

        // WaveSurfer instance is declared globally above

        function initWaveform() {
            if (typeof WaveSurfer === 'undefined') return;

            wavesurfer = WaveSurfer.create({
                container: '#waveform',
                waveColor: '#4f46e5',
                progressColor: '#818cf8',
                cursorColor: '#ffffff',
                barWidth: 2,
                barRadius: 3,
                responsive: true,
                height: 80,
                normalize: true,
                interact: true
            });

            wavesurfer.on('click', () => {
                const time = wavesurfer.getCurrentTime();
                addChapterAtTime(time);
            });

            wavesurfer.on('audioprocess', () => updateWaveformTime());
            wavesurfer.on('ready', () => {
                updateWaveformTime();
                elements.waveformContainer.classList.remove('hidden');
            });
        }

        function updateWaveformTime() {
            if (!wavesurfer) return;
            const current = formatSeconds(wavesurfer.getCurrentTime());
            const total = formatSeconds(wavesurfer.getDuration());
            elements.waveformTime.innerText = `${current} / ${total}`;
        }

        function formatSeconds(seconds) {
            const m = Math.floor(seconds / 60);
            const s = Math.floor(seconds % 60);
            return `${m}:${s.toString().padStart(2, '0')}`;
        }

        function addChapterAtTime(time) {
            const title = `Marker at ${formatSeconds(time)}`;
            const id = Date.now();

            state.chapters.push({
                id,
                title,
                startTime: time,
                duration: 0
            });
            state.chapters.sort((a, b) => a.startTime - b.startTime);

            renderManifest();
            showToast(`Added marker at ${formatSeconds(time)}`, 'info');
        }

        let monitoringInterval = null;
        let jobStartTime = null;

        function setupNavigation() {
            document.querySelectorAll('.nav-item').forEach(item => {
                item.addEventListener('click', () => {
                    const tool = item.dataset.tool;
                    if (state.isProcessing && tool !== state.activeTool) {
                        return showToast('Please wait for current task to finish', 'warning');
                    }
                    switchTool(tool);
                });
            });
        }

        function switchTool(toolId) {
            state.activeTool = toolId;

            document.querySelectorAll('.nav-item').forEach(nav => {
                nav.classList.toggle('active', nav.dataset.tool === toolId);
            });

            document.querySelectorAll('.tool-content').forEach(panel => {
                const isMatch = panel.id === (toolId + 'Panel');
                panel.classList.toggle('active', isMatch);
            });

            // Manifest visibility logic
            const manifestTools = ['conversion', 'audiobook'];
            const previewPanel = document.getElementById('chapterPreviewPanel');
            if (previewPanel) {
                previewPanel.classList.toggle('hidden', !manifestTools.includes(toolId));
            }

            // CLEAR previous file selections and chapter data safe-guards
            if (!state.isProcessing) {
                // Keep chapters if switching between conversion/audiobook? 
                // Peer feedback suggests clearing if switching to a new data source.
                // For now, let's just clear the "FileInfo" displays for other tools
                ['mp3', 'm4b', 'doc'].forEach(id => {
                    const info = document.getElementById(`${id}FileInfo`);
                    if (id !== toolId && (toolId !== 'conversion' || id !== 'mp3')) {
                        // info.classList.add('hidden'); // Optional: clear previous info
                    }
                });
            }

            console.log(`[BPM4B] Switched to ${toolId} pipeline`);
            log(`Switched to ${toolId} pipeline`, 'info');
        }

        function setupTheme() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            applyTheme(savedTheme);
            elements.themeSelector.value = savedTheme;

            elements.themeSelector.addEventListener('change', (e) => {
                applyTheme(e.target.value);
            });
        }

        function applyTheme(themeId) {
            const theme = themes.find(t => t.id === themeId);
            if (!theme) return;

            // Apply CSS custom properties
            const root = document.documentElement;
            root.style.setProperty('--primary', theme.colors.primary);
            root.style.setProperty('--secondary', theme.colors.secondary);
            root.style.setProperty('--accent', theme.colors.accent);
            root.style.setProperty('--bg-app', theme.colors.bgApp);
            root.style.setProperty('--bg-surface', theme.colors.bgSurface);
            root.style.setProperty('--slate-50', theme.colors.slate50);
            root.style.setProperty('--slate-100', theme.colors.slate100);
            root.style.setProperty('--slate-200', theme.colors.slate200);
            root.style.setProperty('--slate-300', theme.colors.slate300);
            root.style.setProperty('--slate-400', theme.colors.slate400);
            root.style.setProperty('--slate-500', theme.colors.slate500);
            root.style.setProperty('--slate-600', theme.colors.slate600);
            root.style.setProperty('--slate-700', theme.colors.slate700);
            root.style.setProperty('--slate-800', theme.colors.slate800);
            root.style.setProperty('--slate-900', theme.colors.slate900);

            // Set data-theme attribute for backward compatibility
            root.setAttribute('data-theme', themeId === 'dark' ? 'dark' : 'light');

            localStorage.setItem('theme', themeId);
            state.theme = themeId;
        }

        function setupDropZones() {
            ['mp3', 'm4b', 'doc', 'cloneRef', 'cloneSrc'].forEach(id => {
                const dz = document.getElementById(`${id}DropZone`);
                const input = document.getElementById(id === 'mp3' ? 'sourceFile' : `${id}File`);
                const info = document.getElementById(`${id}FileInfo`);

                if (!dz || !input) return;

                dz.addEventListener('click', () => input.click());

                dz.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    dz.classList.add('drag-over');
                });

                dz.addEventListener('dragleave', () => dz.classList.remove('drag-over'));

                dz.addEventListener('drop', (e) => {
                    e.preventDefault();
                    dz.classList.remove('drag-over');
                    if (e.dataTransfer.files.length > 0) {
                        handleFileSelect(id, e.dataTransfer.files[0]);
                    }
                });

                input.addEventListener('change', (e) => {
                    if (e.target.files.length > 0) {
                        handleFileSelect(id, e.target.files[0]);
                    }
                });
            });
        }

        function handleFileSelect(id, file) {
            const info = document.getElementById(`${id}FileInfo`);
            info.innerHTML = `
            <div class="file-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="13 2 13 9 20 9" /></svg>
                <span>${file.name}</span>
                <small>${(file.size / (1024 * 1024)).toFixed(1)}MB</small>
            </div>
            `;
            info.classList.remove('hidden');
            log(`Loaded: ${file.name}`, 'success');

            if (id === 'mp3') {
                elements.waveformContainer.classList.remove('hidden');
                if (file.type.startsWith('audio/')) {
                    const url = URL.createObjectURL(file);
                    wavesurfer.load(url);
                } else {
                    elements.waveformContainer.classList.add('hidden');
                }
            }

            if (id === 'doc') {
                document.getElementById('audiobookPanel').querySelectorAll('input, select').forEach(el => {
                    if (el.id === 'audiobookOutputName' || el.id === 'outputName') {
                        el.value = file.name.split('.')[0] + '.mp3';
                    }
                });
            }
        }

        function setupChapterBuilder() {
            elements.addChapterBtn.addEventListener('click', () => {
                elements.quickEntryBar.classList.toggle('hidden');
                if (!elements.quickEntryBar.classList.contains('hidden')) {
                    elements.chapterTitle.focus();
                }
            });

            // Paste Chapters functionality
            const pasteChaptersBtn = document.getElementById('pasteChaptersBtn');
            const pasteChaptersPanel = document.getElementById('pasteChaptersPanel');
            const pasteChaptersText = document.getElementById('pasteChaptersText');
            const cancelPasteBtn = document.getElementById('cancelPasteBtn');
            const parsePasteBtn = document.getElementById('parsePasteBtn');

            pasteChaptersBtn.addEventListener('click', () => {
                pasteChaptersPanel.classList.toggle('hidden');
                if (!pasteChaptersPanel.classList.contains('hidden')) {
                    pasteChaptersText.focus();
                }
            });

            cancelPasteBtn.addEventListener('click', () => {
                pasteChaptersPanel.classList.add('hidden');
                pasteChaptersText.value = '';
            });

            parsePasteBtn.addEventListener('click', () => {
                const text = pasteChaptersText.value.trim();
                if (!text) {
                    showToast('Please paste chapter information', 'error');
                    return;
                }

                const parsedChapters = parsePastedChapters(text);
                if (parsedChapters.length === 0) {
                    showToast('No valid chapters found. Use format: Title = Duration', 'error');
                    return;
                }

                // Clear existing chapters and add parsed ones
                state.chapters = [];
                state.cumulativeTime = 0;

                parsedChapters.forEach(ch => {
                    addChapterMark(ch.title, ch.duration);
                });

                pasteChaptersPanel.classList.add('hidden');
                pasteChaptersText.value = '';
                showToast(`Added ${parsedChapters.length} chapters`, 'success');
            });

            elements.confirmAddChapterBtn.addEventListener('click', () => {
                const title = elements.chapterTitle.value.trim();
                const durationRaw = elements.chapterDuration.value.trim();

                if (!title) return showToast('Enter chapter title', 'error');

                const durationSec = parseDuration(durationRaw);
                if (durationSec === null || durationSec <= 0) {
                    return showToast('Invalid or zero duration', 'error');
                }

                addChapterMark(title, durationSec);

                // Reset and update next
                elements.chapterTitle.value = '';
                elements.chapterDuration.value = '';
                elements.nextTimestamp.textContent = formatTime(state.cumulativeTime);
            });

            elements.chapterDuration.addEventListener('input', (e) => {
                const dur = parseDuration(e.target.value);
                if (dur !== null) {
                    elements.nextTimestamp.textContent = formatTime(state.cumulativeTime + dur);
                } else {
                    elements.nextTimestamp.textContent = formatTime(state.cumulativeTime);
                }
            });

            document.getElementById('clearChaptersBtn').addEventListener('click', () => {
                if (confirm('Are you sure you want to clear all chapters?')) {
                    state.chapters = [];
                    state.cumulativeTime = 0;
                    renderManifest();
                    showToast('Manifest cleared', 'info');
                    elements.nextTimestamp.textContent = '00:00:00';
                }
            });

            window.addChapterMark = (title, durationSec) => {
                const chapter = {
                    id: Date.now(),
                    title: title || `Chapter ${state.chapters.length + 1}`,
                    duration: durationSec,
                    startTime: state.cumulativeTime
                };
                state.chapters.push(chapter);
                state.cumulativeTime += durationSec;
                renderManifest();
                showToast(`Added ${chapter.title}`, 'success');
            };
        }

