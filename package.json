{
    "name": "bpm4b",
    "version": "12.0.0",
    "description": "Professional Multimedia Converter - Local Kokoro-82M TTS & Premium Audio Conversion",
    "main": "lib/server.js",
    "bin": {
        "bpm4b": "bin/bpm4b.js"
    },
    "scripts": {
        "start": "node --max-old-space-size=4096 --max-semi-space-size=256 --expose-gc bin/bpm4b.js web",
        "web": "node --max-old-space-size=4096 --max-semi-space-size=256 --expose-gc bin/bpm4b.js web",
        "convert": "node --max-old-space-size=4096 --max-semi-space-size=256 --expose-gc bin/bpm4b.js convert",
        "test": "test/basic-test.js",
        "build:exe": "node scripts/build-exe.js"
    },
    "keywords": [
        "mp3",
        "m4b",
        "audiobook",
        "converter",
        "ffmpeg",
        "epub",
        "epub-creator",
        "tts",
        "voice-cloning",
        "metadata-editor",
        "batch-merge",
        "kokoro",
        "ai-audiobook",
        "document-to-epub",
        "multimedia-suite"
    ],
    "author": "JDJCHELP",
    "email": "JDJCHELP@proton.me",
    "license": "MIT",
    "dependencies": {
        "commander": "^12.1.0",
        "ejs": "^3.0.2",
        "epub2": "^3.0.2",
        "express": "^4.18.2",
        "ffmpeg-static": "^5.2.0",
        "fluent-ffmpeg": "^2.1.2",
        "localtunnel": "^2.0.2",
        "mammoth": "^1.6.0",
        "multer": "^1.4.5-lts.1",
        "ngrok": "^4.3.3",
        "node-ffprobe": "^3.0.0",
        "number-to-words": "^1.2.4",
        "onnxruntime-node": "^1.24.3",
        "pdf-parse": "^1.1.1",
        "uuid": "^9.0.1",
        "yauzl": "^2.10.0",
        "archiver": "^6.0.1",
        "xml2js": "^0.6.2",
        "marked": "^12.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
